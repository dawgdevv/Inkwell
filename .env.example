# Neon PostgreSQL Configuration (required)
# Use the POOLED connection URL for your Go app (recommended):
#   postgresql://user:password@<project>-pooler.<region>.neon.tech/dbname?sslmode=require
#
# Use the DIRECT connection URL only for migrations/CLI:
#   postgresql://user:password@<project>.<region>.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@your-project-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# JWT secret for auth
JWT_SECRET=your-super-secret-jwt-key-change-this

# Gemini API key for AI-powered autocomplete
GEMINI_API_KEY=your-gemini-api-key

# Server port
PORT=8080
